generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id         String  @id @default(uuid())
  name       String  @unique
  slug       String  @unique
  isSecret   Boolean @default(false)
  orderIndex Int     @default(0)
  items      Item[]
}

model Item {
  id           String   @id @default(uuid())
  url          String
  title        String
  thumbnailUrl String?
  platform     String   // 'youtube', 'website', 'local'
  isLocal      Boolean  @default(false)
  fileSize     Int?
  fileType     String?
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now())
}

model SecretNote {
  id        String   @id @default(uuid())
  title     String   @default("Untitled Note")
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Credential {
  id        String   @id @default(uuid())
  website   String
  username  String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SecretMedia {
  id        String   @id @default(uuid())
  type      String   // 'image' or 'video'
  fileUrl   String
  caption   String   @default("")
  createdAt DateTime @default(now())
}

model VaultConfig {
  id                 String @id @default("global")
  secretFolderCode   String @default("192006")
  secretNotepadCode  String @default("345")
}
